BOT_TOKEN="<YOUR_BOT_TOKEN>"
# BOT_SECRET is the OAuth2 client secret (Developer Portal -> OAuth2)
BOT_SECRET="<YOUR_BOT_SECRET>"
BOT_ID="<YOUR_BOT_ID>"
GEMINI_API="<YOUR_GEMINI_API>"
X_BEARER_TOKEN="<YOUR_X_BEARER_TOKEN>"
X_CLIENT_ID="<YOUR_X_CLIENT_ID>"
X_ACCESS_TOKEN="<YOUR_X_ACCESS_TOKEN>"
X_ACCESS_TOKEN_SECRET="<YOUR_X_ACCESS_TOKEN_SECRET>"
X_API_KEY="<YOUR_X_API_KEY>"
X_API_SECRET="<YOUR_X_API_SECRET>"
GOOGLE_R_CORP="<YOUR_GOOGLE_R_CORP>"
DB_URL="<YOUR_MONGODB_URL>"
OPEN_ROUTER="<YOUR_OPEN_ROUTER>"
PORT=3000
PUBLIC_URL="https://<your-domain>"
VITE_DISCORD_CLIENT_ID="<same as BOT_ID>"
# Header your reverse proxy or tunnel sets to the real client IP (e.g. cf-connecting-ip, x-forwarded-for), used for
# per-IP rate limits. Set it ONLY when a trusted proxy in front of the bot always sets this header: otherwise clients can
# spoof it. Leave empty to turn per-IP limits off for loopback/private addresses.
TRUSTED_CLIENT_IP_HEADER=""
RAZORPAY_KEY_ID="<YOUR_RAZORPAY_KEY_ID>"
RAZORPAY_KEY_SECRET="<YOUR_RAZORPAY_KEY_SECRET>"
RAZORPAY_WEBHOOK_SECRET="<YOUR_RAZORPAY_WEBHOOK_SECRET>"
